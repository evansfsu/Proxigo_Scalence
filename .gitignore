# Proxigo Scalence - Git Ignore

# =============================================================
# Build artifacts
# =============================================================
build/
install/
log/
devel/
*.pyc
__pycache__/
*.egg-info/
.eggs/

# =============================================================
# IDE and Editor
# =============================================================
.vscode/
.idea/
*.swp
*.swo
*~
.project
.cproject
.pydevproject
.settings/

# =============================================================
# ROS2 artifacts
# =============================================================
*.bag
*.db3
*.db3-shm
*.db3-wal

# =============================================================
# Docker
# =============================================================
.docker/

# =============================================================
# Logs
# =============================================================
logs/
*.log
*.log.*

# =============================================================
# Data files (large files - should be managed separately)
# =============================================================
satellite_data/regions/*/satellite.tif
satellite_data/regions/*/elevation.tif
test_data/*.bag
test_data/*.db3
test_data/uav_visloc/
test_data/anyvis_qz/images/
test_data/anyvis_qz/satellite_roi.tif
test_data/anyvis_qz/satellite.png
test_data/anyvis_temp/
UAV_VisLoc_dataset.zip
UAV_VisLoc_example.zip
Data.rar
recordings/

# Keep directory structure
!satellite_data/.gitkeep
!satellite_data/regions/.gitkeep
!test_data/.gitkeep
!recordings/.gitkeep
!logs/.gitkeep

# =============================================================
# Calibration files (machine-specific)
# =============================================================
# config/camera/*_calibration.yaml
# config/camera/*_extrinsics.yaml

# =============================================================
# Operating System
# =============================================================
.DS_Store
Thumbs.db
desktop.ini

# =============================================================
# Python
# =============================================================
venv/
.env
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.coverage
htmlcov/

# =============================================================
# C++
# =============================================================
*.o
*.so
*.a
*.dylib
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json

# =============================================================
# Temporary files
# =============================================================
*.tmp
*.temp
*.bak
*.backup

# Interview prep, drafts, working reports, and personal notes (do not commit)
private_notes/
interview_prep/
drafts/
docs/**/*INTERVIEW*.md
docs/**/*interview*.md
docs/**/*DRAFT*
docs/REPORT_DRAFT*
docs/REPORT_METRIC_CHECKLIST.md

# =============================================================
# VPS tuning outputs and large local datasets
# =============================================================
# Generated evaluation outputs
results*.csv
test_data/**/tuning_runs/

# Large local benchmark assets (keep local only)
test_data/anyvis_qz/
test_data/anyvis_qz_aerial/
test_data/cache/

# Common large archives and raster assets
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tif
*.tiff

# =============================================================
# Local benchmark clones, debug artifacts, and generated reports
# =============================================================
# Local external benchmark/reference snapshots (not project source)
test_data/suas_2022_analysis/
test_data/uav_avl_benchmark_ref/

# Generated debug frame dumps
test_data/**/vnav_like_debug_frames/

# Generated feasibility/ablation outputs
test_data/avl_guideline/
test_data/avl_guideline/feasibility_*.csv
test_data/avl_guideline/feasibility_*.json
test_data/avl_guideline/feasibility_*.md
test_data/avl_guideline/ablation_matrix_report.md
test_data/avl_guideline/root_cause_report.md

# Large local image assets under test_data
test_data/**/*.png
test_data/**/*.jpg
test_data/**/*.jpeg

# Trial portfolio visualizations / demo outputs (regenerate with scripts/)
portfolio_assets/

# Trial or throwaway region caches for demos (not primary test regions)
satellite_data/regions/trial_*/
satellite_data/regions/mock_*/
satellite_data/regions/portfolio_demo/

# VPS device test harness generated frames
src/vps_device/test/output/

# =============================================================
# Repo cleanup: docs/drafts/interview and unfinished feature work
# =============================================================
# Ignore most docs by default (keep only focused public-facing docs)
docs/**
!docs/RECRUITER_REPRO_EVAL.md
!docs/REPORT_EVIDENCE_BUNDLE.md

# Interview / notes / drafts
**/*INTERVIEW*
**/*interview*
**/*DRAFT*
**/drafts/**
**/private_notes/**
**/interview_prep/**

# Unfinished / experimental stacks to keep local
scripts/vps_sim_web/
scripts/vps_avl_*.py
scripts/vps_vnav_like.py
scripts/vps_avl_guideline_runner.py
src/proxigo_bringup/
src/state_fusion/
src/vio_bridge/
src/satellite_matching/

# Trial/mock media generation and report-artifact helper scripts
scripts/generate_mock_portfolio_viz.py
scripts/generate_trial_portfolio_viz.py
scripts/run_mock_vps_demo.py
scripts/run_trial_vps_demo.py
scripts/build_mock_portfolios_three_regions.py
scripts/build_trial_portfolios_three_regions.py
scripts/generate_real_eval_media.py
scripts/generate_trial_quant_report.py
